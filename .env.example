# ==========================================
# 前端配置 (Vite 自动注入以 VITE_ 开头的变量)
# ==========================================

# 后端 API 地址 (本地开发通常为 http://localhost:3001)
# 生产环境或远程访问请填写服务器的 IP 或域名，例如 http://192.168.1.100:3001
VITE_API_URL=http://localhost:3001

# 百度 AppBuilder 网页链接（用于在页面中嵌入或跳转到智能体界面）
VITE_APPBUILDER_URL=https://appbuilder.baidu.com/s/your_appbuilder_url_here

# ==========================================
# 后端配置 (仅后端可见，Server 会读取此文件)
# ==========================================

# 百度 AppBuilder 聊天助手 API 配置
# API Key 格式通常为：Bearer bce-v3/xxxxxxxx...
BAIDU_API_KEY=Bearer your_baidu_api_key_here
BAIDU_APP_ID=your_baidu_app_id_here

# 百度语音识别 (短语音识别标准版) 配置
# 用于语音输入和播报功能
BAIDU_ASR_CLIENT_ID=your_baidu_asr_client_id_here
BAIDU_ASR_CLIENT_SECRET=your_baidu_asr_client_secret_here

# 后端服务端口 (默认 3001)
PORT=3001

# JWT 密钥（用于用户认证，生产环境请更换为复杂随机字符串）
JWT_SECRET=your_jwt_secret_here

